# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Entorno general del servidor
PORT=3000
NODE_ENV="development"
LOG_LEVEL="info"

# Modelos IA Gemini
GEMINI_MODEL_DEFAULT="gemini-2.5-flash"
GEMINI_MODEL_PRO="gemini-2.5-pro"

# Persistencia en Base de Datos (PostgreSQL / Cloud SQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentos"
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="agentos"
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_SSL=false
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000

# Caché y Colas (Redis)
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED=false

# Comunicación en Tiempo Real (WebSockets)
WS_PATH="/ws"
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_PAYLOAD_BYTES=1048576
WS_CORS_ORIGIN="*"

# Observabilidad y Errores (Sentry)
SENTRY_DSN="https://mock@o0.ingest.sentry.io/0"
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE=0

# Telemetría y Métricas (Datadog)
DATADOG_API_KEY="mock_datadog_api_key_0000000000"
DATADOG_APP_KEY="mock_datadog_app_key_0000000000"
DATADOG_SITE="datadoghq.eu"
DATADOG_SERVICE="agentos"
DATADOG_ENV="development"
DATADOG_VERSION="1.0.0"

# Seguridad, Cron y Gobernanza
SESSION_SECRET="super-secret-session-key-dev-32chars"
SYSTEM_SNAPSHOT_CRON_MINUTES=15
AGENT_VCS_SSH_KEY_PATH="/tmp/id_rsa"
DEFAULT_MAX_CREDITS_PER_TASK=100

# Configuración del Backend Git Real (Puntos 2, 3, 7 y Push)
FACTORY_REPO_PATH=".factory-git-workspace"
GIT_REMOTE_URL="https://github.com/LyAi-labs/lyai-ski.git"
GITHUB_REMOTE_URL="https://github.com/LyAi-labs/lyai-ski.git"


